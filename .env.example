# Server
PORT=4000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/quiznest

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=30d

# AI service (question generation / short-answer grading)
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_API_KEY=replace_with_shared_secret_between_backend_and_ai_service

# CORS - comma separated list of allowed origins (mobile app dev origin, web fallback, etc.)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Public URL used to build shareable quiz links (https://quiznest.app/quiz/:code)
PUBLIC_SHARE_BASE_URL=https://quiznest.app/quiz

# Upload limits
MAX_UPLOAD_SIZE_MB=15
